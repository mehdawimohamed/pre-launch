# Environment Variables Template
# Public repository notice: DO NOT COMMIT REAL SECRETS OR VALUES TO THIS FILE.
# Copy this file to .env and configure local development variables.

# Node & General
NODE_ENV=development
PORT=3000

# Database (PostgreSQL 18)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crowdfunding_dev?schema=public"

# Google OAuth
GOOGLE_CLIENT_ID="placeholder-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="placeholder-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# Admin Allowlist (comma-separated emails)
ADMIN_EMAILS="admin@example.com"

# Cloudflare Storage (R2 / S3-compatible)
R2_ACCOUNT_ID="placeholder-account-id"
R2_ACCESS_KEY_ID="placeholder-access-key-id"
R2_SECRET_ACCESS_KEY="placeholder-secret-access-key"
R2_BUCKET_NAME="crowdfunding-dev-bucket"
R2_PUBLIC_DOMAIN="https://assets-dev.example.com"

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY="placeholder-vapid-public-key"
VAPID_PRIVATE_KEY="placeholder-vapid-private-key"
VAPID_SUBJECT="mailto:support@example.com"

# External Modal AI Enhancement Service
MODAL_API_URL="https://example--modal-app.modal.run"
MODAL_API_KEY="placeholder-modal-api-key"
