# Environment Variables Template
# Copy this file to .env in the repo root and fill in your local values.
# This is the ONLY env file — apps read it from the root via resolved paths.
# Never commit .env or prefix a secret with NEXT_PUBLIC_.

# ─── Node & General ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database (PostgreSQL 18) ────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crowdfunding_dev?schema=public"

# ─── API: CORS & Rate Limiting ──────────────────────────────────
CORS_ALLOWED_ORIGINS="http://localhost:3000"
TRUST_TUNNEL_PROXY=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# ─── Google OAuth & Authentication ───────────────────────────────
GOOGLE_CLIENT_ID="placeholder-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="placeholder-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# ─── Admin Allowlist (comma-separated emails) ────────────────────
ADMIN_EMAILS="admin@example.com"

# ─── Sessions & Security ─────────────────────────────────────────
SESSION_LIFETIME_SECONDS=604800
# Optional: set COOKIE_SECURE_OVERRIDE=false for plain HTTP local dev without HTTPS
# In production, leave unset or true so cookies require HTTPS.
COOKIE_SECURE_OVERRIDE=false

# ─── Cloudflare Storage (R2 / S3-compatible) ─────────────────────
R2_ACCOUNT_ID="placeholder-account-id"
R2_ACCESS_KEY_ID="placeholder-access-key-id"
R2_SECRET_ACCESS_KEY="placeholder-secret-access-key"
R2_BUCKET_NAME="crowdfunding-dev-bucket"
R2_PUBLIC_DOMAIN="https://assets-dev.example.com"

# ─── Push Notifications (VAPID) ─────────────────────────────────
VAPID_PUBLIC_KEY="placeholder-vapid-public-key"
VAPID_PRIVATE_KEY="placeholder-vapid-private-key"
VAPID_SUBJECT="mailto:support@example.com"

# ─── Web Client Public Environment Variables ────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="placeholder-google-client-id.apps.googleusercontent.com"

# ─── External Modal AI Enhancement Service ──────────────────────
MODAL_API_URL="https://example--modal-app.modal.run"
MODAL_API_KEY="placeholder-modal-api-key"
